# ── THE SYSTEM · environment ─────────────────────────────────
# Copy to .env.local and fill in. Never commit real keys.

# OpenRouter (LLM + speech) — https://openrouter.ai/keys
OPEN_ROUTER_API_KEY=
# chat model for both Systems
MODEL_ID=anthropic/claude-haiku-5.5
# optional — OpenRouter providers to try first, comma-separated (Claude default: claude-on-aws,anthropic,google-vertex)
# MODEL_PROVIDERS=
# optional — low | medium | high; unset = no reasoning (the voice agent never goes above low)
# MODEL_REASONING=

# optional — Vercel Edge Config; its MODEL_ID item overrides the env var without a redeploy
# EDGE_CONFIG=
# optional — sent to OpenRouter as HTTP-Referer
# SITE_URL=https://your-domain.dev

# optional — a read-only GitHub token: a fine-grained token, "Public repositories" access, no permissions.
# It feeds live project data (without it the server reads GitHub anonymously, 60 requests an hour)
# and "My GitHub" (the contribution calendar needs GraphQL, so that view needs the token).
# GITHUB_TOKEN=

# voice pipeline (OpenRouter audio)
STT_MODEL_ID=mistralai/voxtral-mini-transcribe-3-0
TTS_MODEL_ID=x-ai/grok-voice-tts-1.0
# optional — a voice of the TTS model (Grok: rex, leo, sal are male)
TTS_VOICE=rex

# tracing (LangSmith) — https://smith.langchain.com/settings
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=portfolio
